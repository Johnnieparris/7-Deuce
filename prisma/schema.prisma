generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  createdAt    DateTime       @default(now())
  sessions     PokerSession[]
}

model PokerSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   String
  status String @default("completed")

  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int      @default(0)
  breakMin    Int      @default(0)

  game   String  @default("NLH")
  stakes String?
  venue  String?

  buyIn     Float @default(0)
  cashOut   Float @default(0)
  tips      Float @default(0)
  fees      Float @default(0)
  prize     Float @default(0)
  placement Int?
  fieldSize Int?

  net   Float  @default(0)
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breaks SessionBreak[]

  @@index([userId, startedAt])
  @@index([userId, status])
}

model SessionBreak {
  id        String       @id @default(cuid())
  sessionId String
  session   PokerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
}
